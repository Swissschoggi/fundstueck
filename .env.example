# ---- Fundstück configuration ----

# Server port for the search API + static frontend in production.
PORT=3001

# First-run region. Set this to skip onboarding, or leave empty to choose in
# the browser (CH, US, GB, DE, AT, FR, IT, ES, NL, BE, CA, AU).
# REGION=CH

# Fallback buyer market before onboarding / when no region is stored.
DEFAULT_MARKET=CH

# ---- eBay Browse API (live source) ----
# Create a free application at https://developer.ebay.com/my/keys
# (Application "Client ID"/"Client Secret" — client credentials grant).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace context. EBAY_CH = eBay Switzerland, prices in CHF.
EBAY_MARKETPLACE_ID=EBAY_CH
# Set to "true" to use the eBay Sandbox environment instead of production.
EBAY_USE_SANDBOX=false

# ---- Public search-page adapters (Tutti / Anibis + regional) ----
# Read the public, server-rendered search pages (no /api/ calls, no login,
# no CAPTCHA solving). Requests are rate-limited and cached. On by default.
# ENABLE_TUTTI_ADAPTER=false
# ENABLE_ANIBIS_ADAPTER=false
# Regional pages: Marktplaats, 2dehands, Kleinanzeigen, Willhaben, Subito,
# Kijiji. Only instantiated for the region selected during onboarding.
# ENABLE_REGIONAL_ADAPTERS=false
# Minimum spacing between requests per adapter in ms (>= 1000, default 3000).
# SCRAPER_MIN_INTERVAL_MS=3000
# Identifying user-agent for public-page requests.
# SCRAPER_USER_AGENT=FundstueckBot/0.1 (+https://github.com/anomalyco/fundstuek; polite meta-search)

# ---- Sample data adapter (development) ----
# Deterministic sample listings so the full search journey works without
# any credentials. Sample results are always labelled "Sample" in the UI.
# Defaults: enabled outside production, disabled when NODE_ENV=production.
# ENABLE_SAMPLE_ADAPTER=true

# ---- Optional source plugins (not bundled with the app) ----
# Folder scanned for plugin directories (plugin.json + ESM module). It is
# intentionally empty/absent by default; see plugins.example/ for a template.
# PLUGINS_DIR=./plugins
# Set to "false" to ignore the plugins folder entirely.
# ENABLE_PLUGINS=true
