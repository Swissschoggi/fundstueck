+
+/* ---- Mobile / PWA polish ------------------------------------------------ */
+
+html {
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+  background: var(--surface);
+}
+
+body {
+  -webkit-tap-highlight-color: transparent;
+  /* Notch / landscape insets (viewport-fit=cover). */
+  padding-left: env(safe-area-inset-left);
+  padding-right: env(safe-area-inset-right);
+}
+
+/* No 300ms double-tap-zoom delay on interactive elements. */
+a,
+button,
+input,
+select,
+summary,
+[role='button'] {
+  touch-action: manipulation;
+}
+
+/* iOS Safari zooms the page when focusing an input below 16px. */
+@media (pointer: coarse) {
+  input,
+  select,
+  textarea {
+    font-size: 16px;
+  }
+}
+
+/* Installed app: no accidental text selection / callouts on UI chrome. */
+@media (display-mode: standalone) {
+  button,
+  nav,
+  [role='button'] {
+    -webkit-user-select: none;
+    user-select: none;
+    -webkit-touch-callout: none;
+  }
+}
