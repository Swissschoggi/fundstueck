diff -ruN '--exclude=dist' '--exclude=node_modules' '--exclude=*.png' /tmp/orig/fundstuek/web/src/lib/device.ts fundstuek/web/src/lib/device.ts
--- /tmp/orig/fundstuek/web/src/lib/device.ts	1970-01-01 00:00:00.000000000 +0000
+++ fundstuek/web/src/lib/device.ts	2026-11-11 04:39:36.521388947 +0000
@@ -0,0 +1,14 @@
+/** Stable anonymous id for this browser, used until the person signs in. */
+export function getDeviceId(): string {
+  const key = 'fundstueck.deviceId';
+  try {
+    let id = window.localStorage.getItem(key);
+    if (!id) {
+      id = crypto.randomUUID?.() ?? Math.random().toString(36).slice(2);
+      window.localStorage.setItem(key, id);
+    }
+    return id;
+  } catch {
+    return 'anonymous';
+  }
+}
diff -ruN '--exclude=dist' '--exclude=node_modules' '--exclude=*.png' /tmp/orig/fundstuek/web/src/lib/pwa.ts fundstuek/web/src/lib/pwa.ts
--- /tmp/orig/fundstuek/web/src/lib/pwa.ts	1970-01-01 00:00:00.000000000 +0000
+++ fundstuek/web/src/lib/pwa.ts	2026-11-11 04:41:24.337527078 +0000
@@ -0,0 +1,31 @@
+/** Register the service worker (production builds only) and keep it fresh. */
+export function registerServiceWorker(): void {
+  if (!('serviceWorker' in navigator) || !import.meta.env.PROD) return;
+  window.addEventListener('load', () => {
+    navigator.serviceWorker
+      .register('/sw.js')
+      .then((reg) => {
+        // Installed PWAs stay alive for days on iOS/Android; check for a new
+        // version whenever the app comes back to the foreground.
+        document.addEventListener('visibilitychange', () => {
+          if (document.visibilityState === 'visible') reg.update().catch(() => {});
+        });
+      })
+      .catch(() => {
+        /* PWA features are optional; the site works without them. */
+      });
+  });
+}
+
+export function isStandalone(): boolean {
+  return (
+    window.matchMedia?.('(display-mode: standalone)').matches ||
+    (navigator as Navigator & { standalone?: boolean }).standalone === true
+  );
+}
+
+export function isIos(): boolean {
+  const ua = navigator.userAgent;
+  // iPadOS 13+ reports as Mac; touch points tell them apart.
+  return /iphone|ipad|ipod/i.test(ua) || (ua.includes('Mac') && navigator.maxTouchPoints > 1);
+}
